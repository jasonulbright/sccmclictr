<ui:FluentWindow x:Class="SccmCliCtr.V2Spike.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Client Center for ConfigMgr — v2.0 Spike"
                 Height="500" Width="700"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Client Center for ConfigMgr — v2.0 Spike" />

        <ScrollViewer Grid.Row="1" Padding="32">
            <StackPanel>
                <ui:Card Margin="0,0,0,16" Padding="24">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Title" Text="About this build" />
                        <ui:TextBlock FontTypography="Body" Margin="0,12,0,0"
                                      Text="This is the U0 spike for the v2.0 modernization. Validates that .NET 10 + WPF-UI Fluent renders correctly on this machine." />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,16" Padding="24">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="Stack" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="Runtime" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Grid.Row="0" Grid.Column="1" x:Name="RuntimeText" />
                            <ui:TextBlock Grid.Row="1" Grid.Column="0" Text="Process" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <ui:TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProcessText" Margin="0,4,0,0" />
                            <ui:TextBlock Grid.Row="2" Grid.Column="0" Text="WPF-UI version" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <ui:TextBlock Grid.Row="2" Grid.Column="1" x:Name="WpfUiText" Margin="0,4,0,0" />
                            <ui:TextBlock Grid.Row="3" Grid.Column="0" Text="OS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <ui:TextBlock Grid.Row="3" Grid.Column="1" x:Name="OsText" Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="24">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="Status" />
                        <ui:TextBlock Margin="0,12,0,0" x:Name="StatusText" />
                        <ui:Button Margin="0,16,0,0" Appearance="Primary" Content="Run health probe" Click="OnProbeClick" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
